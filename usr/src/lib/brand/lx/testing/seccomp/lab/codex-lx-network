#!/usr/bin/bash
# Prepare and remove a private Codex network for one lx zone.
set -o errexit
set -o nounset
set -o pipefail

PATH=${CODEX_LX_NETWORK_PATH:-/usr/sbin:/usr/bin:/sbin}
export PATH

state_root=${CODEX_LX_NETWORK_STATE_DIR:-/var/codex-lx-network}
lock_dir=${CODEX_LX_NETWORK_LOCK_DIR:-/var/run/codex-lx-network.lock}
tar_command=${CODEX_LX_TAR:-/usr/bin/gtar}
gzip_command=${CODEX_LX_GZIP:-/usr/bin/gzip}
zstd_command=${CODEX_LX_ZSTD:-/usr/bin/zstd}
rollback_directory=
install_directory=
gate_names=(seccomp userns mntns pidns ipcns netns)

usage()
{
	cat >&2 <<EOF
usage:
  codex-lx-network install ZONE PACKAGE.tar.gz
  codex-lx-network start ZONE PREFIX EGRESS A.B.C COUNT
  codex-lx-network setup ZONE PREFIX EGRESS A.B.C COUNT
  codex-lx-network teardown PREFIX
  codex-lx-network reapply PREFIX
  codex-lx-network recover
  codex-lx-network status [PREFIX]

start and setup create A.B.C.0/24.  The host gateway is A.B.C.1 and COUNT
sandbox links use A.B.C.2 through A.B.C.(COUNT+1).  The controller enables
all required experimental gates and restores their original values when the
last deployment is removed.
EOF
	exit 2
}

die()
{
	printf 'codex-lx-network: %s\n' "$*" >&2
	exit 1
}

acquire_lock()
{
	local -i attempt=0

	mkdir -p "$state_root"
	chmod 700 "$state_root"
	while ! mkdir "$lock_dir" 2>/dev/null; do
		(( attempt += 1 ))
		if (( attempt == 10 )); then
			die "could not acquire $lock_dir"
		fi
		sleep 1
	done
}

release_lock()
{
	rmdir "$lock_dir" 2>/dev/null || true
}

deployment_count()
{
	local -i count=0
	local path

	for path in "$state_root"/*/state; do
		[[ -f "$path" ]] || continue
		(( count += 1 ))
	done
	printf '%s\n' "$count"
}

read_gate()
{
	local gate=$1 value

	value=$(printf 'lx_brand`lx_%s_experimental/D\n' "$gate" | mdb -k |
	    awk 'NF != 0 { value = $NF } END { print value }')
	case "$value" in
	0|0x0)
		printf '%s\n' 0
		;;
	1|0x1)
		printf '%s\n' 1
		;;
	*)
		die "cannot read lx_${gate}_experimental"
		;;
	esac
}

set_gate()
{
	local gate=$1 value=$2

	printf 'lx_brand`lx_%s_experimental/W %s\n' "$gate" "$value" |
	    mdb -kw >/dev/null
}

set_all_gates()
{
	local value=$1 gate

	for gate in "${gate_names[@]}"; do
		set_gate "$gate" "$value"
	done
}

nat_counts()
{
	ipnat -l | awk '
	    /^List of active MAP\/Redirect filters:/ { section = "rules"; next }
	    /^List of active sessions:/ { section = "sessions"; next }
	    NF != 0 && section == "rules" { rules++ }
	    NF != 0 && section == "sessions" { sessions++ }
	    END { print rules + 0, sessions + 0 }
	'
}

flush_owned_nat_sessions()
{
	local nat_rules nat_sessions

	[[ -f "$state_root/base.state" ]] || return
	. "$state_root/base.state"
	read -r nat_rules nat_sessions <<< "$(nat_counts)"
	# Active translations pin their outbound IPF rules.  When the NAT table
	# started empty, every current translation belongs to these deployments.
	if [[ "${nat_rules_were_empty:-no}" == yes &&
	    "${nat_sessions_were_empty:-no}" == yes &&
	    "$nat_sessions" != 0 ]]; then
		ipnat -F
	fi
}

write_base_state()
{
	local forwarding ipf_running gate temporary nat_rules nat_sessions
	local -a values
	local -i index

	forwarding=$(ipadm show-prop -c -o current -p forwarding ipv4)
	ipf_running=$(ipf -V | awk '/^Running:/ { print $2 }')
	[[ "$forwarding" == on || "$forwarding" == off ]] ||
	    die "cannot read the IPv4 forwarding property"
	[[ "$ipf_running" == yes || "$ipf_running" == no ]] ||
	    die "cannot read the IP Filter state"
	read -r nat_rules nat_sessions <<< "$(nat_counts)"
	for gate in "${gate_names[@]}"; do
		values+=("$(read_gate "$gate")")
	done
	temporary=$state_root/base.state.$$
	{
		printf 'forwarding_was=%s\n' "$forwarding"
		printf 'ipf_was=%s\n' "$ipf_running"
		printf 'nat_rules_were_empty=%s\n' \
		    "$([[ "$nat_rules" == 0 ]] && printf yes || printf no)"
		printf 'nat_sessions_were_empty=%s\n' \
		    "$([[ "$nat_sessions" == 0 ]] && printf yes || printf no)"
		for ((index = 0; index < ${#gate_names[@]}; index++)); do
			printf '%s_was=%s\n' "${gate_names[index]}" \
			    "${values[index]}"
		done
	} > "$temporary"
	chmod 600 "$temporary"
	mv "$temporary" "$state_root/base.state"
}

restore_base_state()
{
	local gate variable value

	[[ -f "$state_root/base.state" ]] || return
	. "$state_root/base.state"
	ipadm set-prop -t -p "forwarding=$forwarding_was" ipv4
	for gate in "${gate_names[@]}"; do
		variable=${gate}_was
		value=${!variable}
		[[ "$value" == 0 || "$value" == 1 ]] ||
		    die "invalid saved gate value: $gate"
		set_gate "$gate" "$value"
	done
	flush_owned_nat_sessions
	if [[ "$ipf_was" == no ]]; then
		ipf -D 2>/dev/null || true
	fi
	rm -f "$state_root/base.state"
}

remove_deployment()
{
	local directory=$1
	local link rules status
	local -i last=0

	[[ -f "$directory/state" ]] || die "missing deployment state: $directory"
	. "$directory/state"
	status=$(zoneadm -z "$zone" list -p 2>/dev/null |
	    awk -F: 'NR == 1 { print $3 }')
	if [[ "$status" == running || "$status" == ready ||
	    "$status" == shutting_down || "$status" == down ]]; then
		zoneadm -z "$zone" halt 2>/dev/null || true
	fi
	if [[ -f "$directory/ipnat.rules" ]]; then
		ipnat -r -f "$directory/ipnat.rules" 2>/dev/null || true
	fi
	flush_owned_nat_sessions
	if (( $(deployment_count) == 1 )); then
		last=1
	fi
	for rules in "$directory"/ipf-*.rules; do
		[[ -f "$rules" ]] || continue
		ipf -r -f "$rules" 2>/dev/null || true
	done
	if [[ -f "$directory/ipf.rules" ]]; then
		ipf -r -f "$directory/ipf.rules" 2>/dev/null || true
	fi
	[[ ! -f "$config" ]] || rm -f "$config"
	ipadm delete-addr "$host/v4" 2>/dev/null || true
	ipadm delete-if "$host" 2>/dev/null || true
	for link in ${links//,/ }; do
		link=${link%%=*}
		dladm delete-vnic "$link" 2>/dev/null || true
	done
	dladm delete-vnic "$host" 2>/dev/null || true
	dladm delete-etherstub "$stub" 2>/dev/null || true
	rm -f "$directory/ipnat.rules" "$directory"/ipf-*.rules \
	    "$directory/ipf.rules" "$directory/state"
	rmdir "$directory"
	if (( last != 0 )); then
		restore_base_state
	fi
}

rollback_setup()
{
	local result=$?

	trap - EXIT HUP INT TERM
	set +o errexit
	remove_deployment "$rollback_directory"
	release_lock
	exit "$result"
}

rollback_install()
{
	local result=$?

	trap - EXIT HUP INT TERM
	set +o errexit
	if [[ -n "$install_directory" && -d "$install_directory" ]]; then
		rm -rf "$install_directory"
	fi
	release_lock
	exit "$result"
}

archive_stream()
{
	local package=$1

	case "$package" in
	*.tar.gz|*.tgz)
		[[ -x "$gzip_command" ]] || die "gzip is not available"
		"$gzip_command" -dc "$package"
		;;
	*.tar.zst|*.tar.zstd)
		[[ -x "$zstd_command" ]] ||
		    die "zstd is not available; use a .tar.gz package"
		"$zstd_command" -dc "$package"
		;;
	*)
		die "package must end in .tar.gz, .tgz, .tar.zst or .tar.zstd"
		;;
	esac
}

install_package()
{
	(( $# == 2 )) || usage
	local zone=$1 package=$2 record status zonepath brand target
	local list

	[[ "$zone" =~ ^[A-Za-z0-9_.-]+$ ]] || die "invalid zone name"
	[[ "$package" == /* && -f "$package" ]] ||
	    die "package must be an existing absolute path"
	record=$(zoneadm -z "$zone" list -p 2>/dev/null) ||
	    die "zone does not exist: $zone"
	status=$(printf '%s\n' "$record" | awk -F: 'NR == 1 { print $3 }')
	zonepath=$(printf '%s\n' "$record" | awk -F: 'NR == 1 { print $4 }')
	brand=$(printf '%s\n' "$record" | awk -F: 'NR == 1 { print $6 }')
	[[ "$status" == installed ]] || die "zone must be installed, not $status"
	[[ "$brand" == lx ]] || die "zone brand must be lx, not $brand"
	[[ "$zonepath" =~ ^/[A-Za-z0-9_./-]+$ ]] ||
	    die "cannot determine a safe zone path"
	target=$zonepath/root/opt/codex-lx
	[[ ! -e "$target" ]] || die "package is already installed: $target"
	[[ -d "$zonepath/root" ]] || die "zone root is missing: $zonepath/root"

	list=$(mktemp "$state_root/package-list.XXXXXX")
	if ! archive_stream "$package" | "$tar_command" -tf - > "$list"; then
		rm -f "$list"
		die "cannot list package archive"
	fi
	if ! awk '
	    BEGIN { good = 1 }
	    $0 !~ /^codex-lx-private\// { good = 0 }
	    $0 ~ /(^|\/)\.\.(\/|$)/ { good = 0 }
	    END { exit !(NR != 0 && good) }
	' "$list"; then
		rm -f "$list"
		die "package archive has an unsafe layout"
	fi
	rm -f "$list"

	mkdir -p "$zonepath/root/opt"
	install_directory=$zonepath/root/opt/.codex-lx-install.$$
	[[ ! -e "$install_directory" ]]
	mkdir "$install_directory"
	trap rollback_install EXIT HUP INT TERM
	archive_stream "$package" | "$tar_command" -xf - \
	    --strip-components=1 -C "$install_directory"
	[[ -x "$install_directory/codex-lx" ]] ||
	    die "package is missing executable codex-lx"
	[[ -f "$install_directory/lx-package-manifest.json" ]] ||
	    die "package manifest is missing"
	mv "$install_directory" "$target"
	install_directory=
	trap - EXIT HUP INT TERM
	printf 'CODEX_LX_INSTALLED zone=%s path=%s\n' "$zone" "$target"
}

setup()
{
	(( $# == 5 )) || usage
	local zone=$1 prefix=$2 egress=$3 network=$4 count=$5
	local directory stub host gateway subnet zonepath zone_root config
	local links='' link rules address status octet first=0
	local -i index value

	[[ "$zone" =~ ^[A-Za-z0-9_.-]+$ ]] || die "invalid zone name"
	[[ "$prefix" =~ ^[A-Za-z0-9]+$ && ${#prefix} -le 10 ]] ||
	    die "PREFIX must contain at most 10 letters or digits"
	[[ "$egress" =~ ^[A-Za-z0-9_.-]+$ ]] || die "invalid egress link"
	[[ "$network" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] ||
	    die "network must contain the first three IPv4 octets"
	for octet in ${network//./ }; do
		[[ "$octet" == 0 || "$octet" != 0* ]] ||
		    die "IPv4 octets must not contain leading zeroes"
		value=$((10#$octet))
		(( value >= 0 && value <= 255 )) || die "invalid IPv4 octet"
	done
	[[ "$count" =~ ^[0-9]+$ ]] || die "COUNT must be an integer"
	(( count >= 1 && count <= 32 )) || die "COUNT must be from 1 to 32"
	dladm show-link -p -o link "$egress" >/dev/null 2>&1 ||
	    die "egress link does not exist: $egress"
	status=$(zoneadm -z "$zone" list -p 2>/dev/null |
	    awk -F: 'NR == 1 { print $3 }')
	[[ "$status" == installed ]] || die "zone must be installed, not $status"
	zonepath=$(zonecfg -z "$zone" info zonepath |
	    awk '$1 == "zonepath:" { print $2 }')
	[[ "$zonepath" =~ ^/[A-Za-z0-9_./-]+$ ]] ||
	    die "cannot determine a safe zone path"
	zone_root=$zonepath/root
	config=$zone_root/etc/codex-lx-network.conf
	[[ ! -e "$config" ]] || die "network config already exists: $config"

	directory=$state_root/$prefix
	[[ ! -e "$directory" ]] || die "deployment prefix already exists: $prefix"
	stub=${prefix}stub0
	host=${prefix}host0
	gateway=$network.1
	subnet=$network.0/24
	for ((index = 0; index < count; index++)); do
		link=${prefix}net$index
		address=$network.$((index + 2))/24
		[[ -z "$links" ]] || links+=,
		links+=$link=$address
	done

	if (( $(deployment_count) == 0 )); then
		write_base_state
		first=1
	fi
	if ! mkdir "$directory"; then
		(( first == 0 )) || restore_base_state
		die "cannot create deployment state: $directory"
	fi
	chmod 700 "$directory"
	cat > "$directory/state.new" <<EOF
zone='$zone'
prefix='$prefix'
egress='$egress'
network='$network'
count='$count'
stub='$stub'
host='$host'
gateway='$gateway'
subnet='$subnet'
zone_root='$zone_root'
config='$config'
links='$links'
EOF
	chmod 600 "$directory/state.new"
	mv "$directory/state.new" "$directory/state"

	rollback_directory=$directory
	trap rollback_setup EXIT
	trap 'exit 125' HUP INT TERM
	ipadm set-prop -t -p forwarding=on ipv4
	set_all_gates 1
	ipf -E 2>/dev/null || true
	dladm create-etherstub -t "$stub"
	dladm create-vnic -t -l "$stub" "$host"
	for link in ${links//,/ }; do
		link=${link%%=*}
		dladm create-vnic -t -l "$stub" "$link"
	done
	ipadm create-if -t "$host"
	ipadm create-addr -t -T static -a "$gateway/24" "$host/v4"
	cat > "$directory/ipf-in-host.rules" <<EOF
pass in quick on $host from $subnet to any
EOF
	cat > "$directory/ipf-in-egress.rules" <<EOF
pass in quick on $egress from any to $subnet
EOF
	cat > "$directory/ipf-out-host.rules" <<EOF
pass out quick on $host from any to $subnet
EOF
	cat > "$directory/ipf-out-egress.rules" <<EOF
pass out quick on $egress from $subnet to any
EOF
	cat > "$directory/ipnat.rules" <<EOF
map $egress $subnet -> 0/32 portmap tcp/udp auto
map $egress $subnet -> 0/32
EOF
	for rules in "$directory"/ipf-*.rules; do
		ipf -f "$rules"
	done
	ipnat -f "$directory/ipnat.rules"
	zoneadm -z "$zone" ready
	for link in ${links//,/ }; do
		link=${link%%=*}
		dladm set-linkprop -t -p "zone=$zone" "$link"
	done
	cat > "$config" <<EOF
CODEX_LX_NET_LINKS='$links'
CODEX_LX_NET_GATEWAY='$gateway'
EOF
	chmod 644 "$config"
	zoneadm -z "$zone" boot
	trap - EXIT HUP INT TERM
	rollback_directory=
	release_lock
	printf 'CODEX_LX_NETWORK_READY zone=%s prefix=%s links=%s gateway=%s\n' \
	    "$zone" "$prefix" "$count" "$gateway"
}

teardown()
{
	(( $# == 1 )) || usage
	local prefix=$1 directory

	[[ "$prefix" =~ ^[A-Za-z0-9]+$ && ${#prefix} -le 10 ]] ||
	    die "invalid deployment prefix"
	directory=$state_root/$prefix
	remove_deployment "$directory"
	printf 'CODEX_LX_NETWORK_REMOVED prefix=%s\n' "$prefix"
}

reapply()
{
	(( $# == 1 )) || usage
	local requested=$1 directory
	local saved_zone saved_prefix saved_egress saved_network saved_count

	[[ "$requested" =~ ^[A-Za-z0-9]+$ && ${#requested} -le 10 ]] ||
	    die "invalid deployment prefix"
	directory=$state_root/$requested
	[[ -f "$directory/state" ]] || die "missing deployment state: $directory"
	. "$directory/state"
	saved_zone=$zone
	saved_prefix=$prefix
	saved_egress=$egress
	saved_network=$network
	saved_count=$count
	remove_deployment "$directory"
	setup "$saved_zone" "$saved_prefix" "$saved_egress" "$saved_network" \
	    "$saved_count"
}

recover()
{
	(( $# == 0 )) || usage
	local state directory
	local -i removed=0

	for state in "$state_root"/*/state; do
		[[ -f "$state" ]] || continue
		directory=${state%/state}
		remove_deployment "$directory"
		(( removed += 1 ))
	done
	if (( removed == 0 )) && [[ -f "$state_root/base.state" ]]; then
		restore_base_state
	fi
	printf 'CODEX_LX_NETWORK_RECOVERED deployments=%d\n' "$removed"
}

status_command()
{
	(( $# <= 1 )) || usage
	local requested=${1:-} path found=0 status health

	if [[ -n "$requested" ]]; then
		[[ "$requested" =~ ^[A-Za-z0-9]+$ && ${#requested} -le 10 ]] ||
		    die "invalid deployment prefix"
	fi

	for path in "$state_root"/*/state; do
		[[ -f "$path" ]] || continue
		. "$path"
		[[ -z "$requested" || "$prefix" == "$requested" ]] || continue
		status=$(zoneadm -z "$zone" list -p 2>/dev/null |
		    awk -F: 'NR == 1 { print $3 }')
		health=stale
		if [[ "$status" == running && -f "$config" ]] &&
		    dladm show-link -p -o link "$stub" >/dev/null 2>&1; then
			health=ready
		fi
		printf 'zone=%s prefix=%s subnet=%s egress=%s links=%s status=%s health=%s\n' \
		    "$zone" "$prefix" "$subnet" "$egress" "$count" \
		    "${status:-missing}" "$health"
		found=1
	done
	if (( found == 0 )); then
		[[ -z "$requested" ]] || die "deployment does not exist: $requested"
		printf '%s\n' 'no Codex lx network deployments'
	fi
}

(( $# >= 1 )) || usage
command=$1
shift
case "$command" in
install|setup|start|teardown|reapply|recover|status)
	acquire_lock
	trap release_lock EXIT HUP INT TERM
	case "$command" in
	install)
		install_package "$@"
		;;
	start)
		setup "$@"
		;;
	status)
		status_command "$@"
		;;
	*)
		"$command" "$@"
		;;
	esac
	trap - EXIT HUP INT TERM
	release_lock
	;;
*)
	usage
	;;
esac
