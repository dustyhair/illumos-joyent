<?xml version="1.0"?>
<!DOCTYPE service_bundle SYSTEM "/usr/share/lib/xml/dtd/service_bundle.dtd.1">
<service_bundle type="manifest" name="codex-lx-network-recovery">
  <service name="application/codex-lx-network-recovery"
      type="service" version="1">
    <create_default_instance enabled="true"/>
    <single_instance/>

    <dependency name="filesystem-local" grouping="require_all"
        restart_on="none" type="service">
      <service_fmri value="svc:/system/filesystem/local"/>
    </dependency>
    <dependency name="network-physical" grouping="require_all"
        restart_on="none" type="service">
      <service_fmri value="svc:/network/physical:default"/>
    </dependency>

    <exec_method type="method" name="start"
        exec="/opt/codex-lx-network recover" timeout_seconds="120"/>
    <exec_method type="method" name="stop" exec=":true"
        timeout_seconds="0"/>

    <property_group name="startd" type="framework">
      <propval name="duration" type="astring" value="transient"/>
    </property_group>
    <stability value="Unstable"/>

    <template>
      <common_name>
        <loctext xml:lang="C">Codex LX network recovery</loctext>
      </common_name>
      <description>
        <loctext xml:lang="C">Remove stale Codex LX network state after boot</loctext>
      </description>
    </template>
  </service>
</service_bundle>
